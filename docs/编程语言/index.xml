			<item>
				<title>编程规范</title>
				<link>https://Patchouli-ovo.github.io/docs/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80/%E7%BC%96%E7%A8%8B%E8%A7%84%E8%8C%83/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://Patchouli-ovo.github.io/docs/%E7%BC%96%E7%A8%8B%E8%AF%AD%E8%A8%80/%E7%BC%96%E7%A8%8B%E8%A7%84%E8%8C%83/</guid>
				<description>&lt;h1 id=&#34;编程规范&#34;&gt;编程规范&lt;a class=&#34;anchor&#34; href=&#34;#%e7%bc%96%e7%a8%8b%e8%a7%84%e8%8c%83&#34;&gt;#&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;h2 id=&#34;变量命名规范&#34;&gt;变量命名规范&lt;a class=&#34;anchor&#34; href=&#34;#%e5%8f%98%e9%87%8f%e5%91%bd%e5%90%8d%e8%a7%84%e8%8c%83&#34;&gt;#&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;strong&gt;宏与常量：全大写，单词用下划线分隔。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;类型名：大驼峰，可加 _t 或 _Typedef 后缀。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;函数名：大驼峰，模块名作前缀。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;全局变量：小驼峰或下划线，加 g_ 前缀。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;静态变量：小驼峰或下划线，加 s_ 前缀。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;局部变量：小驼峰或下划线。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;结构体成员：小驼峰或下划线。&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;</description>
			</item>
